# Servidor de gerenciamento do Signa Ludus (dono do banco). Só o backend fala com ele.
NODE_ENV=development

# Na mesma máquina do backend, deixe 127.0.0.1 (ninguém de fora alcança).
# Em outra máquina, use o endereço da rede privada e proteja com firewall/HTTPS.
HOST=127.0.0.1
PORT=8090

DATABASE_URL=mongodb://localhost:27017/signa-ludus

# Segredo compartilhado com o backend (mesmo valor de SERVER_SERVICE_KEY no backend/.env), 64+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SERVICE_KEY=

# Painel web (/admin): quanto tempo a sessão vale depois do login (1 a 72 horas).
ADMIN_SESSION_HOURS=8
# true = cookie do painel só por HTTPS. Padrão: true em produção, false em desenvolvimento (127.0.0.1 via HTTP).
# ADMIN_COOKIE_SECURE=true
