# Servidor de gerenciamento do Signa Ludus (dono do banco). Só o backend fala com ele.
NODE_ENV=development

# Na mesma máquina do backend, deixe 127.0.0.1 (ninguém de fora alcança).
# Em outra máquina, use o endereço da rede privada e proteja com firewall/HTTPS.
HOST=127.0.0.1
PORT=8090

DATABASE_URL=mongodb://localhost:27017/signa-ludus

# Segredo compartilhado com o backend (mesmo valor de SERVER_SERVICE_KEY no backend/.env), 64+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SERVICE_KEY=

# Painel web (/admin): quanto tempo a sessão vale depois do login (1 a 72 horas).
ADMIN_SESSION_HOURS=8
# true = cookie do painel só por HTTPS. Padrão: true em produção, false em desenvolvimento (127.0.0.1 via HTTP).
# ADMIN_COOKIE_SECURE=true

# E-mail (recuperação de senha). Sem chave de provedor: nada é enviado (em desenvolvimento o código vai para o log).
# Remetente que aparece para a pessoa:
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Signa Ludus

# Brevo (principal; não exige domínio próprio): chave em Brevo → SMTP & API → API Keys.
# MAIL_FROM_EMAIL precisa estar confirmado em Brevo → Senders (pode ser um Gmail do projeto).
BREVO_API_KEY=

# Mailtrap (alternativa, usado só sem BREVO_API_KEY): Settings → API Tokens. Exige domínio verificado em Sending Domains.
MAILTRAP_API_TOKEN=
# Opcional: id da caixa de testes (Email Testing → Inboxes). Com ele, os e-mails vão para a caixa do Mailtrap e não
# chegam a ninguém (bom para testar sem domínio verificado).
MAILTRAP_INBOX_ID=

# Login com Google: o "Web client ID" do Google Cloud (o mesmo de VITE_GOOGLE_WEB_CLIENT_ID no app).
# Vários separados por vírgula. Vazio = login com Google desligado.
GOOGLE_CLIENT_IDS=

# Notificação no celular (app fechado) pelo Firebase Cloud Messaging: o JSON da conta de serviço do Firebase
# (Configurações do projeto → Contas de serviço → Gerar nova chave privada), colado inteiro ou em base64.
# Vazio = só as notificações dentro do app (sino e aviso no topo, em tempo real).
FIREBASE_SERVICE_ACCOUNT=
