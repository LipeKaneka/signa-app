# Usado só no build do APK (npm run build:android). Copie para .env.android.
# O celular não enxerga "localhost": use o endereço público da API (https).
VITE_API_URL=https://api.seu-dominio.com.br/api/v1

# Login com Google: o "Web client ID" do Google Cloud (OAuth, tipo "Aplicativo da Web"). O mesmo valor vai em
# GOOGLE_CLIENT_IDS no server/.env. Vazio = o botão do Google só avisa que não está disponível.
VITE_GOOGLE_WEB_CLIENT_ID=
