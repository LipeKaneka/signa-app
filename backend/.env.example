# Copie para .env e preencha. Nunca versione o .env.

# Porta da API
PORT=8080
NODE_ENV=development

# Endereços do frontend autorizados (CORS), separados por vírgula.
# O frontend roda em outro servidor: coloque aqui a URL pública dele.
# https://localhost = app Android (APK feito com Capacitor).
FRONTEND_URL=http://localhost:5173,https://localhost

# Servidor de gerenciamento (o backend não tem banco: pede tudo à API interna do servidor).
# Mesma máquina: 127.0.0.1. Servidor em outra máquina: troque só esta URL (de preferência HTTPS em rede privada).
SERVER_URL=http://127.0.0.1:8090/internal/v1
# Mesmo valor de SERVICE_KEY no server/.env (64+ caracteres).
SERVER_SERVICE_KEY=
# De quanto em quanto tempo (ms) o backend confere se o conteúdo mudou no servidor (0 = a cada pedido).
# Conteúdo público (dicionário, eventos, textos do app) fica em cache até a versão do conteúdo mudar.
CONTENT_VERSION_TTL_MS=10000
# Requisições por minuto por IP aceitas pela API do app.
API_RATE_LIMIT_PER_MINUTE=300

# JWT: segredo aleatório com pelo menos 128 caracteres (ex.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Assistente com IA (opcional). Sem chave, o assistente responde só com o dicionário.
# Use UMA das chaves: GEMINI_API_KEY (Google AI Studio) tem prioridade; senão ANTHROPIC_API_KEY (Claude).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: gemini-flash-latest com Gemini, claude-opus-5-5 com Claude.
AI_MODEL=
# Reservas quando o modelo principal está sobrecarregado (opcional, separados por vírgula).
# Padrão: gemini-flash-lite-latest com Gemini, claude-haiku-5-5 com Claude.
AI_FALLBACK_MODELS=
